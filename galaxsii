local function safeParent()
    if gethui then return gethui() end
    local ok, cg = pcall(gs, game, "CoreGui")
    if ok and cg then return cg end
    return lp:WaitForChild("PlayerGui")
end

local function newScreenGui()
    local sg = Instance.new("ScreenGui")
    if syn and syn.protect_gui then
        syn.protect_gui(sg)
        local ok, cg = pcall(gs, game, "CoreGui")
        sg.Parent = ok and cg or safeParent()
    elseif protect_gui then
        protect_gui(sg)
        local ok, cg = pcall(gs, game, "CoreGui")
        sg.Parent = ok and cg or safeParent()
    else
        sg.Parent = safeParent()
    end
    sg.Name           = ("%x%x"):format(math.random(0xFFFF,0xFFFFF), math.random(0xFFFF,0xFFFFF))
    sg.ResetOnSpawn   = false
    sg.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    sg.DisplayOrder   = 9999
    sg.IgnoreGuiInset = true
    task.spawn(function()
        while task.wait(0.5) do
            pcall(function()
                if sg and sg.Parent == nil then sg.Parent = safeParent() end
            end)
        end
    end)
    return sg
end

local function safe(fn, ...)
    local ok, err = pcall(fn, ...)
end

