local function moveToPosition(character, targetPosition, activeFn)
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if not root then return end

    local startPos = root.Position
    local direction = (targetPosition - startPos)
    local horizDir = Vector3.new(direction.X, 0, direction.Z)
    local distance = horizDir.Magnitude

    while distance > STEP_DISTANCE do
        if activeFn and not activeFn() then return end
        root = character:FindFirstChild("HumanoidRootPart")
        if not root then return end
        startPos = root.Position
        horizDir = Vector3.new(targetPosition.X - startPos.X, 0, targetPosition.Z - startPos.Z)
        distance = horizDir.Magnitude
        if distance <= STEP_DISTANCE then break end
        local step = (horizDir.Unit) * STEP_DISTANCE
        local nextPos = Vector3.new(startPos.X + step.X, targetPosition.Y, startPos.Z + step.Z)
        pcall(function() root.CFrame = CFrame.new(nextPos) end)
        task.wait(STEP_WAIT)
        distance = (Vector3.new(targetPosition.X, targetPosition.Y, targetPosition.Z) - nextPos).Magnitude
    end

    pcall(function()
        root = character:FindFirstChild("HumanoidRootPart")
        if root then root.CFrame = CFrame.new(targetPosition) end
    end)
end

