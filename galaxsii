local function chipMoveToNPC(npc)
    if not farmActive then return false end
    if immChip[1] then return false end
    immChip[1] = true
    local root = getRoot()
    if not root then immChip[1]=false; return false end
    local targetPos = npc and npc:FindFirstChild("HumanoidRootPart") and npc.HumanoidRootPart.Position
    if not targetPos then immChip[1]=false; return false end
    local SS = 0.9
    pcall(function() root.CFrame = CFrame.new(root.Position.X, UNDERGROUND_Y_CHIP, root.Position.Z) end)
    task.wait(0.05)
    local targetH = Vector3.new(targetPos.X, UNDERGROUND_Y_CHIP, targetPos.Z)
    while farmActive do
        local cur  = root.Position
        local dist = (Vector2.new(targetH.X,targetH.Z)-Vector2.new(cur.X,cur.Z)).Magnitude
        if dist < SS then break end
        if npc:GetAttribute("AnimationState") ~= "Sitting" then break end
        local dir     = (targetH-cur).Unit
        local nextPos = cur + dir*SS
        pcall(function()
            root.CFrame = CFrame.new(Vector3.new(nextPos.X, UNDERGROUND_Y_CHIP, nextPos.Z),
                Vector3.new(nextPos.X+dir.X, UNDERGROUND_Y_CHIP, nextPos.Z+dir.Z))
        end)
        task.wait(0.06)
    end
    if farmActive then
        pcall(function() root.CFrame = CFrame.new(targetPos.X, targetPos.Y, targetPos.Z) end)
    end
    immChip[1] = false; return true
end

