        if v:IsA("ProximityPrompt") and whitelist[v] then
            v.Enabled = true
            v.RequiresLineOfSight = false
            v.MaxActivationDistance = 30
            v.HoldDuration = 0
        end
    end
end

local function restorePrompts()
    for _, v in ipairs(workspace:GetDescendants()) do
