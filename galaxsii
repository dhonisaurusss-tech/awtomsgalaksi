local function mk(cls, props, parent)
    local i = Instance.new(cls)
    if cls == "Frame" or cls == "TextButton" or cls == "TextBox" then
        i.BorderSizePixel = 0
    end
    for k, v in next, props do pcall(function() i[k] = v end) end
    if parent then i.Parent = parent end
    return i
end

local function corner(p, r)
    return mk("UICorner", {CornerRadius = UDim.new(0, r or 8)}, p)
end

local function outline(p, col, thick)
    return mk("UIStroke", {Color = col or T.Border, Thickness = thick or 1}, p)
end

local function lbl(parent, props)
    local d = {
        BackgroundTransparency = 1,
        Font       = Enum.Font.Gotham,
        TextSize   = isMobile and 15 or 13,
        TextColor3 = T.TxtSec,
        TextXAlignment = Enum.TextXAlignment.Left,
    }
    for k, v in next, props do d[k] = v end
    return mk("TextLabel", d, parent)
end

local function tw(obj, props, t, sty, dir)
    TweenSvc:Create(obj,
        TweenInfo.new(t or 0.15, sty or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out),
        props):Play()
end

local function makeDraggable(root, handle)
    handle = handle or root
    local drag, ds, sp = false, nil, nil

    local function onBegan(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1
        or i.UserInputType == Enum.UserInputType.Touch then
            drag = true; ds = i.Position; sp = root.Position
        end
    end
    local function onChanged(i)
        if drag and (i.UserInputType == Enum.UserInputType.MouseMovement
                  or i.UserInputType == Enum.UserInputType.Touch) then
            local d = i.Position - ds
            root.Position = UDim2.new(sp.X.Scale, sp.X.Offset + d.X, sp.Y.Scale, sp.Y.Offset + d.Y)
        end
    end
    local function onEnded(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1
        or i.UserInputType == Enum.UserInputType.Touch then
            drag = false
        end
    end

    handle.InputBegan:Connect(onBegan)
    UIS.InputChanged:Connect(onChanged)
    UIS.InputEnded:Connect(onEnded)
end

