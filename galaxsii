    end
end

local function formatTime(s)
    local h=math.floor(s/3600); local m=math.floor((s%3600)/60); local ss=math.floor(s%60)
    return h>0 and string.format("%02d:%02d:%02d",h,m,ss) or string.format("%02d:%02d",m,ss)
end
local function formatMoney(n)
    local str=tostring(math.floor(n))
    return "$"..str:reverse():gsub("%d%d%d","%1,"):reverse():gsub("^,","")
end

local function safeFirePrompt(pp)
    if not pp then return false end
    if not pcall(function() return pp:IsA("ProximityPrompt") end) then return false end
    if not pp:IsA("ProximityPrompt") then return false end
    if not pp.Parent then return false end
    pcall(function()
        pp.MaxActivationDistance = 30; pp.Enabled = true
        pp.HoldDuration = 0; pp.RequiresLineOfSight = false
        if pp.Parent and pp.Parent:IsA("BasePart") then
            workspace.CurrentCamera.CFrame =
                CFrame.new(workspace.CurrentCamera.CFrame.Position, pp.Parent.Position)
        end
        pp:InputHoldBegin(); task.wait(0.05); pp:InputHoldEnd()
    end)
    return true
end

