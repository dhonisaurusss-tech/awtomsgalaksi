                    task.wait(5.7)

                    chipMove(Vector3.new(-521,4,-465))
                    local potOk,potPrompt=pcall(function()
                        return workspace.Map.Locations["The Laboratory"].Pots:GetChildren()[7].ProximityPrompt
                    end)
